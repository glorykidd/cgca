@page "/contact"

<PageTitle>Contact Us | Cedar Grove Christian Academy</PageTitle>
<HeadContent>
  <meta name="description" content="Contact Cedar Grove Christian Academy in Shepherdsville, KY. Call (502) 543-4101, email contactus@cedargrovechristianacademy.org, or use our contact form. Located at 4900 Cedar Grove Rd." />
  <meta property="og:title" content="Contact Us | Cedar Grove Christian Academy" />
  <meta property="og:description" content="Get in touch with CGCA. Call (502) 543-4101 or visit us at 4900 Cedar Grove Rd, Shepherdsville, KY 40165." />
  <meta property="og:url" content="https://www.cedargrovechristianacademy.org/contact" />
  <link rel="canonical" href="https://www.cedargrovechristianacademy.org/contact" />
</HeadContent>

<section aria-label="Contact information">
  <div class="row">
    <div class="col-12">
      <div class="section-header">
        <p class="section-header-title">Contact Us</p>
        <p class="section-header-subtitle">We'd love to hear from you</p>
      </div>
    </div>
  </div>
</section>

<div class="row"><div class="col-12">&nbsp;</div></div>

<!-- Contact Info + Map -->
<section aria-label="Location and contact details">
  <div class="row g-4">
    <div class="col-md-5 col-sm-12">
      <Card TextAlignment="Alignment.Start" Style="border: 0px;">
        <CardBody>
          <CardTitle Style="font-size: 1.5em;">Get In Touch</CardTitle>
          <CardText>
            <div style="font-size: 1.1em; line-height: 2.2em;">
              <p>
                <Icon Name="IconName.GeoAlt" />&nbsp;&nbsp;<strong>Address</strong><br />
                <span style="padding-left: 2em;">4900 Cedar Grove Rd</span><br />
                <span style="padding-left: 2em;">Shepherdsville, KY 40165</span>
              </p>
              <p>
                <Icon Name="IconName.Telephone" />&nbsp;&nbsp;<strong>Phone</strong><br />
                <span style="padding-left: 2em;"><a href="tel:+15025434101">(502) 543-4101</a></span>
              </p>
              <p>
                <Icon Name="IconName.Envelope" />&nbsp;&nbsp;<strong>Email</strong><br />
                <span style="padding-left: 2em;"><a href="mailto:contactus@cedargrovechristianacademy.org">contactus@cedargrovechristianacademy.org</a></span>
              </p>
              <p>
                <Icon Name="IconName.Clock" />&nbsp;&nbsp;<strong>School Hours</strong><br />
                <span style="padding-left: 2em;">Tue - Thu, 9:30 AM - 12:30 PM</span>
              </p>
            </div>
          </CardText>
        </CardBody>
      </Card>
      <div class="text-center-full" style="margin-top: 15px;">
        <Button Type="ButtonType.Link" Color="ButtonColor.Success" Target="Target.Blank" Size="ButtonSize.Large"
          Class="btn-rounded" To="https://forms.gle/85pj7RGUHaMUNiQy6">
          <Icon Name="IconName.EnvelopeAt" />
          &nbsp;&nbsp;Subscribe to Email Newsletter&nbsp;&nbsp;
        </Button>
      </div>
    </div>
    <div class="col-md-7 col-sm-12">
      <iframe
        class="embed-rounded"
        style="height: 400px;"
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3133.5!2d-85.7137!3d37.9789!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x886972c0a5f6b7d1%3A0x1234567890abcdef!2s4900+Cedar+Grove+Rd%2C+Shepherdsville%2C+KY+40165!5e0!3m2!1sen!2sus!4v1709000000000"
        title="Cedar Grove Christian Academy location map"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen></iframe>
    </div>
  </div>
</section>

<div class="row"><div class="col-12">&nbsp;</div></div>

<!-- Contact Form -->
<section aria-label="Contact form">
  <div class="row">
    <div class="col-12">
      <div class="section-header">
        <p class="section-header-title">Send Us a Message</p>
      </div>
    </div>
  </div>
  <div class="row"><div class="col-12">&nbsp;</div></div>
  <div class="row justify-content-center">
    <div class="col-md-10 col-sm-12">
      <iframe class="embed-rounded embed-responsive-item" style="height: 700px;"
        src="https://forms.gle/sEakenNv3o7Jckaa8"
        title="CGCA Contact Form"
        loading="lazy"
        allowfullscreen></iframe>
    </div>
  </div>
</section>
