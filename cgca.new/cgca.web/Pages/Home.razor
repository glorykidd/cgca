@page "/"

<PageTitle>Cedar Grove Christian Academy | Christ-Centered Pre-School in Shepherdsville, KY</PageTitle>
<HeadContent>
  <meta name="description" content="Cedar Grove Christian Academy offers Christ-centered pre-school education for ages 3-5 in Shepherdsville, KY. Small class sizes, biblical worldview, and academic rigor. Now enrolling for 2026/27!" />
  <meta property="og:title" content="Cedar Grove Christian Academy | Christ-Centered Pre-School" />
  <meta property="og:description" content="Christ-centered pre-school for ages 3-5 in Shepherdsville, KY. Academic rigor, biblical worldview, small class sizes. Enroll today!" />
  <meta property="og:url" content="https://www.cedargrovechristianacademy.org/" />
  <link rel="canonical" href="https://www.cedargrovechristianacademy.org/" />
</HeadContent>

<!-- Hero Section -->
<section class="hero-banner" aria-label="Welcome to Cedar Grove Christian Academy">
  <div class="row align-items-center">
    <div class="col-lg-7 col-md-12">
      <h1 class="hero-headline">Rooted in Christ.<br />Ready for Tomorrow.</h1>
      <p class="hero-subtext">
        Cedar Grove Christian Academy provides a Christ-centered pre-school experience where your child
        grows spiritually, academically, and socially in a nurturing, faith-filled environment.
      </p>
      <div class="hero-cta-group">
        <Button Type="ButtonType.Link" Color="ButtonColor.Success" Target="Target.Blank" Size="ButtonSize.ExtraLarge"
          Class="btn-rounded" To="https://app.praxischool.com/site_login.php?s=4101">
          <Icon Name="IconName.Alarm" />
          &nbsp;&nbsp;Enroll Now&nbsp;&nbsp;
          <Icon Name="IconName.Alarm" />
        </Button>
        <a href="/admissions" class="btn btn-outline-primary btn-lg btn-rounded ms-2">
          Learn About Admissions
        </a>
      </div>
    </div>
    <div class="col-lg-5 col-md-12 mt-4 mt-lg-0">
      <iframe class="embed-rounded embed-responsive-item" style="height: 320px;"
        src="https://embed.sermonaudio.com/player/v/32624147123685/"
        title="Cedar Grove Christian Academy sermon audio player"
        loading="lazy"
        allowfullscreen></iframe>
    </div>
  </div>
</section>

<!-- Enrollment Banner -->
<section class="enrollment-banner" aria-label="Enrollment announcement">
  <div class="row">
    <div class="col-12">
      <Alert Color="AlertColor.Success" style="text-align: center; border-radius: 25px; font-size: 1.1em;">
        <Icon Name="IconName.CheckCircleFill" class="me-2"></Icon>
        <strong>Registration now open for the 2026/27 school year!</strong>
        Limited openings for Pre-School ages 3, 4, and 5. Sibling discounts and pay-in-full savings available!
      </Alert>
    </div>
  </div>
</section>

<!-- Quick Facts Strip -->
<section class="quick-facts" aria-label="Quick facts about our school">
  <div class="row text-center g-4">
    <div class="col-6 col-md-3">
      <div class="fact-item">
        <Icon Name="IconName.BookHalf" Size="IconSize.x3" class="fact-icon" />
        <h3 class="fact-number">K3 - K5</h3>
        <p class="fact-label">Pre-School Programs</p>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="fact-item">
        <Icon Name="IconName.Calendar3" Size="IconSize.x3" class="fact-icon" />
        <h3 class="fact-number">Tue - Thu</h3>
        <p class="fact-label">9:30 AM - 12:30 PM</p>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="fact-item">
        <Icon Name="IconName.BookHalf" Size="IconSize.x3" class="fact-icon" />
        <h3 class="fact-number">Faith-Based</h3>
        <p class="fact-label">Biblical Worldview</p>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="fact-item">
        <Icon Name="IconName.People" Size="IconSize.x3" class="fact-icon" />
        <h3 class="fact-number">Small Classes</h3>
        <p class="fact-label">Individual Attention</p>
      </div>
    </div>
  </div>
</section>

<div class="row"><div class="col-12">&nbsp;</div></div>

<!-- Why Choose CGCA -->
<section aria-label="Why choose Cedar Grove Christian Academy">
  <div class="row">
    <div class="col-12">
      <div class="section-header">
        <p class="section-header-title">- Why Choose CGCA? -</p>
      </div>
    </div>
  </div>
  <div class="row"><div class="col-12">&nbsp;</div></div>
  <div class="row g-4">
    <div class="col-sm-12 col-md-4">
      <Card TextAlignment="Alignment.Center" Style="border: 0px;">
        <CardBody>
          <img src="images/ourmission.png" alt="Academic rigor icon" loading="lazy" style="height: 100px; padding-bottom: 10px;" />
          <CardTitle Style="font-size: 1.5em;">Academic Rigor</CardTitle>
          <CardText>
            <p class="text-justify">We educate students using all the academic disciplines, engaging them in
              the pursuit of God's truth in all spheres of life. Our curriculum prepares the next generation
              of Christian leaders.</p>
          </CardText>
          <a href="/programs" class="text-decoration-none">Explore Programs &rarr;</a>
        </CardBody>
      </Card>
    </div>
    <div class="col-sm-12 col-md-4">
      <Card TextAlignment="Alignment.Center" Style="border: 0px;">
        <CardBody>
          <img src="images/corevalues.png" alt="Biblical worldview icon" loading="lazy" style="height: 100px; padding-bottom: 10px;" />
          <CardTitle Style="font-size: 1.5em;">Biblical Worldview</CardTitle>
          <CardText>
            <p class="text-justify">Every subject is taught through the lens of Scripture. Students develop
              a foundation of faith that equips them to understand God's truth and apply it to every area
              of their lives.</p>
          </CardText>
          <a href="/about" class="text-decoration-none">Our Mission &rarr;</a>
        </CardBody>
      </Card>
    </div>
    <div class="col-sm-12 col-md-4">
      <Card TextAlignment="Alignment.Center" Style="border: 0px;">
        <CardBody>
          <img src="images/discrimination.png" alt="Welcoming community icon" loading="lazy" style="height: 100px; padding-bottom: 10px;" />
          <CardTitle Style="font-size: 1.5em;">Christ-Centered</CardTitle>
          <CardText>
            <p class="text-justify">A ministry of Cedar Grove Baptist Church, our academy exists to
              faithfully proclaim the gospel of Jesus Christ and equip students to think and live
              Biblically.</p>
          </CardText>
          <a href="/about" class="text-decoration-none">Statement of Faith &rarr;</a>
        </CardBody>
      </Card>
    </div>
  </div>
</section>

<div class="row"><div class="col-12">&nbsp;</div></div>

<!-- Our ABC's -->
<section aria-label="Core values">
  <div class="row">
    <div class="col-12">
      <div class="section-header">
        <p class="section-header-title">The ABC's of CGCA</p>
        <p class="section-header-subtitle">What we are committed to delivering</p>
      </div>
    </div>
  </div>
  <div class="row"><div class="col-12">&nbsp;</div></div>
  <div class="row g-4 justify-content-center">
    <div class="col-sm-12 col-md-4 text-center">
      <h2 class="abc-letter">A</h2>
      <h4>Academic Rigor</h4>
      <p>Challenging curriculum that prepares students for academic success while developing critical thinking skills.</p>
    </div>
    <div class="col-sm-12 col-md-4 text-center">
      <h2 class="abc-letter">B</h2>
      <h4>Biblical World-view</h4>
      <p>Every subject taught through the lens of Scripture, building a foundation of faith that lasts a lifetime.</p>
    </div>
    <div class="col-sm-12 col-md-4 text-center">
      <h2 class="abc-letter">C</h2>
      <h4>Christ Centered</h4>
      <p>Jesus Christ is at the heart of everything we do, from classroom instruction to community service.</p>
    </div>
  </div>
</section>

<div class="row"><div class="col-12">&nbsp;</div></div>

<!-- Non-discrimination & CTA -->
<section aria-label="Our students">
  <div class="row">
    <div class="col-12">
      <Card TextAlignment="Alignment.Center" Style="border: 0px;">
        <CardBody>
          <CardTitle>Our Students</CardTitle>
          <CardText>
            <p class="text-justify">Cedar Grove Christian Academy admits students of any race, color, and national
              or ethnic origin to all the rights, privileges, programs, and activities generally accorded or made
              available to students at the school. It does not discriminate on the basis of race, color, or national
              or ethnic origin in the administration of its educational policies, admissions policies, scholarship
              programs, and athletic or other school-administered programs.</p>
          </CardText>
        </CardBody>
      </Card>
    </div>
  </div>
</section>

<div class="row"><div class="col-12">&nbsp;</div></div>

<!-- Bottom CTA -->
<section class="bottom-cta" aria-label="Call to action">
  <div class="row">
    <div class="col-12 text-center">
      <div class="section-header" style="padding: 40px 25px;">
        <p class="section-header-title">Ready to Give Your Child a Foundation of Faith?</p>
        <p class="section-header-subtitle" style="margin-bottom: 1rem;">Spaces are limited for the 2026/27 school year.</p>
        <Button Type="ButtonType.Link" Color="ButtonColor.Light" Target="Target.Blank" Size="ButtonSize.ExtraLarge"
          Class="btn-rounded" To="https://app.praxischool.com/site_login.php?s=4101">
          &nbsp;&nbsp;Enroll Today&nbsp;&nbsp;
        </Button>
        <a href="/contact" class="btn btn-outline-light btn-lg btn-rounded ms-2">
          Contact Us
        </a>
      </div>
    </div>
  </div>
</section>
