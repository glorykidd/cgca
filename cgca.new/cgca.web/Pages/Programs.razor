@page "/programs"

<PageTitle>Pre-School Programs | K3, K4 &amp; K5 | Cedar Grove Christian Academy</PageTitle>
<HeadContent>
  <meta name="description" content="Explore Cedar Grove Christian Academy's Christ-centered pre-school programs for ages 3-5. K3 and K4/K5 classes run Tuesday-Thursday, 9:30 AM-12:30 PM in Shepherdsville, KY." />
  <meta property="og:title" content="Pre-School Programs | Cedar Grove Christian Academy" />
  <meta property="og:description" content="Christ-centered pre-school programs for K3 and K4/K5 in Shepherdsville, KY. Small class sizes, biblical worldview, hands-on learning." />
  <meta property="og:url" content="https://www.cedargrovechristianacademy.org/programs" />
  <link rel="canonical" href="https://www.cedargrovechristianacademy.org/programs" />
</HeadContent>

