<div class="row"><div class="col-12">&nbsp;</div></div>

<!-- K3 Program -->
<section aria-label="K3 Pre-School program">
  <div class="row">
    <div class="col-12">
      <div class="section-header">
        <p class="section-header-title">Pre-School K3</p>
        <p class="section-header-subtitle">For children age 3</p>
      </div>
    </div>
  </div>
  <div class="row"><div class="col-12">&nbsp;</div></div>
  <div class="row">
    <div class="col-sm-12 col-md-6">
      <Card TextAlignment="Alignment.Start" Style="border: 0px;">
        <CardBody>
          <CardTitle><i>Building Early Foundations</i></CardTitle>
          <CardText>
            <p class="text-justify">Our K3 program introduces three-year-olds to the joy of learning in a
              warm, structured environment rooted in Christian values. Through age-appropriate activities,
              children develop social skills, early literacy, numeracy concepts, and a love for God's creation.</p>
            <p class="text-justify">Each day includes Bible time, circle time, hands-on learning centers,
              creative arts, music, outdoor play, and structured activities designed to develop the whole child
              — spiritually, academically, socially, and physically.</p>
          </CardText>
        </CardBody>
      </Card>
    </div>
    <div class="col-sm-12 col-md-6">
      <Card TextAlignment="Alignment.Start" Style="border: 0px;">
        <CardBody>
          <CardTitle>What Your Child Will Learn</CardTitle>
          <CardText>
            <ul style="line-height: 2em; font-size: 1.1em;">
              <li>Bible stories, memory verses, and prayer</li>
              <li>Letter and number recognition</li>
              <li>Fine and gross motor skill development</li>
              <li>Colors, shapes, and early science concepts</li>
              <li>Social skills and sharing in a group setting</li>
              <li>Creative expression through art and music</li>
            </ul>
          </CardText>
        </CardBody>
      </Card>
    </div>
  </div>
</section>

<div class="row"><div class="col-12">&nbsp;</div></div>

<!-- K4/K5 Program -->
<section aria-label="K4 and K5 Pre-School program">
  <div class="row">
    <div class="col-12">
      <div class="section-header">
        <p class="section-header-title">Pre-School K4 / K5</p>
        <p class="section-header-subtitle">For children ages 4 and 5</p>
      </div>
    </div>
  </div>
  <div class="row"><div class="col-12">&nbsp;</div></div>
  <div class="row">
    <div class="col-sm-12 col-md-6">
      <Card TextAlignment="Alignment.Start" Style="border: 0px;">
        <CardBody>
          <CardTitle><i>Preparing for Tomorrow</i></CardTitle>
          <CardText>
            <p class="text-justify">Our K4/K5 program builds on the K3 foundation with more structured
              academic preparation while maintaining the Christ-centered focus that makes CGCA unique.
              Students develop kindergarten-readiness skills alongside a deepening understanding of God's
              Word and their place in His world.</p>
            <p class="text-justify">With a focus on early reading, writing, and math skills, your child will
              enter kindergarten confident, prepared, and grounded in faith. Our missions program, based on
              Acts 1:8, gives students hands-on experience serving their community.</p>
          </CardText>
        </CardBody>
      </Card>
    </div>
    <div class="col-sm-12 col-md-6">
      <Card TextAlignment="Alignment.Start" Style="border: 0px;">
        <CardBody>
          <CardTitle>What Your Child Will Learn</CardTitle>
          <CardText>
            <ul style="line-height: 2em; font-size: 1.1em;">
              <li>Bible study, Scripture memorization, and daily devotions</li>
              <li>Phonics, early reading, and writing skills</li>
              <li>Number concepts, counting, and early math</li>
              <li>Science exploration and discovery</li>
              <li>Community service through our missions program</li>
              <li>Kindergarten readiness and social development</li>
            </ul>
          </CardText>
        </CardBody>
      </Card>
    </div>
  </div>
</section>

<div class="row"><div class="col-12">&nbsp;</div></div>

