@page "/sponsors"
@rendermode InteractiveServer
@using cgca.web.Models
@using cgca.web.Services

<PageTitle>Partner With Us | Sponsorship Opportunities | Cedar Grove Christian Academy</PageTitle>
<HeadContent>
  <meta name="description" content="Partner with Cedar Grove Christian Academy as an annual sponsor. Support Christ-centered education in Bullitt County, Kentucky and invest in the next generation of Christian leaders." />
  <meta property="og:title" content="Partner With Us | Cedar Grove Christian Academy" />
  <meta property="og:description" content="Become a sponsor and help keep Christ-centered education accessible for families in Bullitt County." />
  <meta property="og:url" content="https://www.cedargrovechristianacademy.org/sponsors" />
  <link rel="canonical" href="https://www.cedargrovechristianacademy.org/sponsors" />
</HeadContent>

<!-- Hero Section -->
<section aria-label="Sponsorship hero">
  <div class="row">
    <div class="col-12 text-center sponsor-hero">
      <h1 class="sponsor-hero-title">Partner with Cedar Grove Christian Academy</h1>
      <p class="sponsor-hero-subtitle">Invest in the future of Bullitt County's children</p>
    </div>
  </div>
</section>

<div class="row">
  <div class="col-12">&nbsp;</div>
</div>

<!-- Why Partner Section -->
<section aria-label="Why partner with us">
  <div class="row">
    <div class="col-sm-12 col-md-8 offset-md-2">
      <Card TextAlignment="Alignment.Start" Style="border: 0px;">
        <CardBody>
          <CardText>
            <p class="sponsor-text">Cedar Grove Christian Academy is a ministry of Cedar Grove Baptist Church,
              located right here in Bullitt County, Kentucky. Our mission is to faithfully proclaim the gospel of
              Jesus Christ, to equip and train students to think and live Biblically, and to prepare the next
              generation of Christian leaders.</p>
            <p class="sponsor-text">As we continue to grow and serve more families in the 2026&ndash;27 school year,
              we are looking for local partners who share our commitment to youth development and the strength
              of our community. Your support helps us keep Christian education accessible and ensures that every
              student who walks through our doors receives an excellent academic foundation paired with a
              Christ-centered experience.</p>
          </CardText>
        </CardBody>
      </Card>
    </div>
  </div>
</section>

<div class="row">
  <div class="col-12">&nbsp;</div>
</div>

<!-- Sponsorship Tiers Section -->
<section aria-label="Sponsorship levels">
  <div class="row">
    <div class="col-12">
      <div class="section-header">
        <p class="section-header-title">Sponsorship Levels</p>
        <p class="section-header-subtitle">Every level of partnership makes a real difference</p>
      </div>
    </div>
  </div>
  <div class="row">
    <div class="col-12">&nbsp;</div>
  </div>
  <div class="row justify-content-center">
    <div class="col-sm-12 col-md-4 mb-4">
      <div class="tier-card tier-gold">
        <div class="tier-badge">Gold</div>
        <div class="tier-amount">$1,500</div>
        <ul class="tier-benefits">
          <li>Mentions on our website and social media</li>
          <li>Logo placement on the school website</li>
          <li>Name on our Wall of Sponsors</li>
          <li>Larger featured logo placement on the website</li>
          <li>Signage on the playground fence</li>
        </ul>
        <button class="btn btn-sponsor btn-gold" @onclick='() => SelectTier("Gold")'>Become a Gold Sponsor</button>
      </div>
    </div>
    <div class="col-sm-12 col-md-4 mb-4">
      <div class="tier-card tier-silver">
        <div class="tier-badge">Silver</div>
        <div class="tier-amount">$750</div>
        <ul class="tier-benefits">
          <li>Mentions on our website and social media</li>
          <li>Logo placement on the school website</li>
          <li>Name on our Wall of Sponsors</li>
        </ul>
        <button class="btn btn-sponsor btn-silver" @onclick='() => SelectTier("Silver")'>Become a Silver Sponsor</button>
      </div>
    </div>
    <div class="col-sm-12 col-md-4 mb-4">
      <div class="tier-card tier-bronze">
        <div class="tier-badge">Bronze</div>
        <div class="tier-amount">$250</div>
        <ul class="tier-benefits">
          <li>Mentions on our website and social media</li>
        </ul>
        <button class="btn btn-sponsor btn-bronze" @onclick='() => SelectTier("Bronze")'>Become a Bronze Sponsor</button>
      </div>
    </div>
  </div>
</section>

<div class="row">
  <div class="col-12">&nbsp;</div>
</div>

<!-- Our Sponsors Section -->
<section aria-label="Our sponsors">
  <div class="row">
    <div class="col-12">
      <div class="section-header">
        <p class="section-header-title">Our Sponsors</p>
        <p class="section-header-subtitle">Thank you to our generous partners</p>
      </div>
    </div>
  </div>

  @if (GoldSponsors.Any())
  {
    <div class="row mb-3">
      <div class="col-12">
        <h4 class="sponsor-tier-heading sponsor-tier-gold">Gold Sponsors</h4>
      </div>
    </div>
    <div class="row justify-content-center mb-4">
      @foreach (var sponsor in GoldSponsors)
      {
        <div class="col-6 col-md-4 col-lg-3 mb-3">
          <div class="sponsor-card">
            @if (!string.IsNullOrEmpty(sponsor.Website))
            {
              <a href="@sponsor.Website" target="_blank" rel="noopener noreferrer">
                <img src="/images/sponsors/@sponsor.Logo" alt="@sponsor.Name" class="sponsor-logo sponsor-logo-gold" loading="lazy" />
              </a>
            }
            else
            {
              <img src="/images/sponsors/@sponsor.Logo" alt="@sponsor.Name" class="sponsor-logo sponsor-logo-gold" loading="lazy" />
            }
            <p class="sponsor-name">@sponsor.Name</p>
          </div>
        </div>
      }
    </div>
  }

  @if (SilverSponsors.Any())
  {
    <div class="row mb-3">
      <div class="col-12">
        <h4 class="sponsor-tier-heading sponsor-tier-silver">Silver Sponsors</h4>
      </div>
    </div>
    <div class="row justify-content-center mb-4">
      @foreach (var sponsor in SilverSponsors)
      {
        <div class="col-6 col-md-4 col-lg-3 mb-3">
          <div class="sponsor-card">
            @if (!string.IsNullOrEmpty(sponsor.Website))
            {
              <a href="@sponsor.Website" target="_blank" rel="noopener noreferrer">
                <img src="/images/sponsors/@sponsor.Logo" alt="@sponsor.Name" class="sponsor-logo sponsor-logo-silver" loading="lazy" />
              </a>
            }
            else
            {
              <img src="/images/sponsors/@sponsor.Logo" alt="@sponsor.Name" class="sponsor-logo sponsor-logo-silver" loading="lazy" />
            }
            <p class="sponsor-name">@sponsor.Name</p>
          </div>
        </div>
      }
    </div>
  }

  @if (BronzeSponsors.Any())
  {
    <div class="row mb-3">
      <div class="col-12">
        <h4 class="sponsor-tier-heading sponsor-tier-bronze">Bronze Sponsors</h4>
      </div>
    </div>
    <div class="row justify-content-center mb-4">
      @foreach (var sponsor in BronzeSponsors)
      {
        <div class="col-6 col-md-4 col-lg-3 mb-3">
          <div class="sponsor-card">
            @if (!string.IsNullOrEmpty(sponsor.Website))
            {
              <a href="@sponsor.Website" target="_blank" rel="noopener noreferrer">
                <img src="/images/sponsors/@sponsor.Logo" alt="@sponsor.Name" class="sponsor-logo sponsor-logo-bronze" loading="lazy" />
              </a>
            }
            else
            {
              <img src="/images/sponsors/@sponsor.Logo" alt="@sponsor.Name" class="sponsor-logo sponsor-logo-bronze" loading="lazy" />
            }
            <p class="sponsor-name">@sponsor.Name</p>
          </div>
        </div>
      }
    </div>
  }

  @if (!GoldSponsors.Any() && !SilverSponsors.Any() && !BronzeSponsors.Any())
  {
    <div class="row">
      <div class="col-12 text-center">
        <p class="sponsor-placeholder">Be our first sponsor! Partner with CGCA and make a lasting impact.</p>
      </div>
    </div>
  }
</section>

<div class="row">
  <div class="col-12">&nbsp;</div>
</div>

<!-- Sponsorship Form -->
<section aria-label="Sponsorship inquiry form" id="sponsor-form">
  <div class="row">
    <div class="col-12">
      <div class="section-header">
        <p class="section-header-title">Get In Touch</p>
        <p class="section-header-subtitle">Ready to make a difference? Fill out the form below.</p>
      </div>
    </div>
  </div>
  <div class="row"><div class="col-12">&nbsp;</div></div>
  <div class="row justify-content-center">
    <div class="col-md-8 col-sm-12">

      @if (submitted)
      {
        <div class="alert alert-success" role="alert">
          <h5>Thank you, @submittedName!</h5>
          <p class="mb-0">We've received your sponsorship inquiry and will be in touch soon. A confirmation has been sent to your email.</p>
        </div>
      }
      else if (submitError)
      {
        <div class="alert alert-danger" role="alert">
          Something went wrong. Please try again or contact us directly at (502) 543-4101.
        </div>
      }
      else
      {
        <EditForm Model="form" OnValidSubmit="HandleSubmit">
          <DataAnnotationsValidator />

          <div class="mb-3">
            <label class="form-label">Contact Name <span class="text-danger">*</span></label>
            <InputText class="form-control" @bind-Value="form.ContactName" placeholder="Your full name" />
            <ValidationMessage For="() => form.ContactName" />
          </div>

          <div class="mb-3">
            <label class="form-label">Business Name</label>
            <InputText class="form-control" @bind-Value="form.BusinessName" placeholder="Your business or organization (optional)" />
            <ValidationMessage For="() => form.BusinessName" />
          </div>

          <div class="mb-3">
            <label class="form-label">Email <span class="text-danger">*</span></label>
            <InputText type="email" class="form-control" @bind-Value="form.Email" placeholder="your@email.com" />
            <ValidationMessage For="() => form.Email" />
          </div>

          <div class="row mb-3">
            <div class="col-sm-6">
              <label class="form-label">Phone</label>
              <InputText class="form-control" @bind-Value="form.Phone" placeholder="(555) 555-5555" />
            </div>
            <div class="col-sm-6">
              <label class="form-label">Sponsorship Level <span class="text-danger">*</span></label>
              <InputSelect class="form-select" @bind-Value="form.SponsorshipTier">
                <option value="">-- Select a level --</option>
                <option value="Gold">Gold ($1,500)</option>
                <option value="Silver">Silver ($750)</option>
                <option value="Bronze">Bronze ($250)</option>
              </InputSelect>
              <ValidationMessage For="() => form.SponsorshipTier" />
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label">Message</label>
            <InputTextArea class="form-control" @bind-Value="form.Message" rows="4" placeholder="Any questions or additional details..." />
          </div>

          <div class="text-center">
            <button type="submit" class="btn btn-success btn-lg btn-rounded" disabled="@submitting">
              @if (submitting)
              {
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
              }
              <Icon Name="IconName.HeartFill" />
              &nbsp;&nbsp;Submit Sponsorship Inquiry&nbsp;&nbsp;
              <Icon Name="IconName.HeartFill" />
            </button>
          </div>
        </EditForm>
      }

    </div>
  </div>
</section>

<div class="row">
  <div class="col-12">&nbsp;</div>
</div>

@code {
    [Inject] private SponsorshipSubmissionService SubmissionService { get; set; } = default!;

    private SponsorForm form = new();
    private bool submitted;
    private bool submitting;
    private bool submitError;
    private string submittedName = "";

    private record SponsorInfo(string Name, string Logo, string Tier, string? Website = null);

    private List<SponsorInfo> SponsorList { get; } = new()
    {
        // Add sponsors here as they come in. Example:
        // new("Acme Corp", "acme-corp.png", "Gold", "https://www.acmecorp.com"),
        // new("Local Hardware", "local-hardware.png", "Silver"),
        // new("Joe's Diner", "joes-diner.png", "Bronze", "https://www.joesdiner.com"),
    };

    private IEnumerable<SponsorInfo> GoldSponsors => SponsorList.Where(s => string.Equals(s.Tier, "Gold", StringComparison.OrdinalIgnoreCase));
    private IEnumerable<SponsorInfo> SilverSponsors => SponsorList.Where(s => string.Equals(s.Tier, "Silver", StringComparison.OrdinalIgnoreCase));
    private IEnumerable<SponsorInfo> BronzeSponsors => SponsorList.Where(s => string.Equals(s.Tier, "Bronze", StringComparison.OrdinalIgnoreCase));

    private void SelectTier(string tier)
    {
        form.SponsorshipTier = tier;
        // scroll to form
    }

    private async Task HandleSubmit()
    {
        submitting = true;
        submitError = false;

        var submission = new SponsorshipSubmission
        {
            ContactName = form.ContactName,
            BusinessName = string.IsNullOrWhiteSpace(form.BusinessName) ? null : form.BusinessName,
            Email = form.Email,
            Phone = string.IsNullOrWhiteSpace(form.Phone) ? null : form.Phone,
            SponsorshipTier = form.SponsorshipTier,
            Message = string.IsNullOrWhiteSpace(form.Message) ? null : form.Message
        };

        var success = await SubmissionService.SubmitAsync(submission);
        submitting = false;

        if (success)
        {
            submittedName = form.ContactName;
            submitted = true;
        }
        else
        {
            submitError = true;
        }
    }

    private class SponsorForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Contact name is required.")]
        [System.ComponentModel.DataAnnotations.StringLength(100)]
        public string ContactName { get; set; } = "";

        [System.ComponentModel.DataAnnotations.StringLength(200)]
        public string? BusinessName { get; set; }

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Email is required.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Please enter a valid email.")]
        public string Email { get; set; } = "";

        public string? Phone { get; set; }

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Please select a sponsorship level.")]
        public string SponsorshipTier { get; set; } = "";

        [System.ComponentModel.DataAnnotations.StringLength(2000)]
        public string? Message { get; set; }
    }
}
