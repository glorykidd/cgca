@page "/admissions"

<PageTitle>Admissions &amp; Tuition | Cedar Grove Christian Academy</PageTitle>
<HeadContent>
  <meta name="description" content="Enroll at Cedar Grove Christian Academy. Tuition is $175/month for Pre-School K3-K5. Registration fee $125. Sibling discounts and pay-in-full savings available. Shepherdsville, KY." />
  <meta property="og:title" content="Admissions & Tuition | Cedar Grove Christian Academy" />
  <meta property="og:description" content="Affordable Christ-centered pre-school: $175/month with sibling discounts. Registration open for 2026/27 in Shepherdsville, KY." />
  <meta property="og:url" content="https://www.cedargrovechristianacademy.org/admissions" />
  <link rel="canonical" href="https://www.cedargrovechristianacademy.org/admissions" />
</HeadContent>

<section aria-label="Admissions overview">
  <div class="row">
    <div class="col-12">
      <div class="section-header">
        <p class="section-header-title">Admissions &amp; Tuition</p>
        <p class="section-header-subtitle">2026/27 School Year</p>
      </div>
    </div>
  </div>
</section>

<div class="row"><div class="col-12">&nbsp;</div></div>

<!-- How to Enroll -->
<section aria-label="How to enroll">
  <div class="row">
    <div class="col-12 text-center">
      <h2>How to Enroll</h2>
      <p style="font-size: 1.1em;">Getting started is easy. Follow these simple steps to secure your child's spot.</p>
    </div>
  </div>
  <div class="row"><div class="col-12">&nbsp;</div></div>
  <div class="row g-4 text-center">
    <div class="col-sm-12 col-md-4">
      <div class="enroll-step">
        <div class="step-number">1</div>
        <h4>Register Online</h4>
        <p>Complete the registration form through our Praxis School portal. Select your child's program (K3 or K4/K5).</p>
      </div>
    </div>
    <div class="col-sm-12 col-md-4">
      <div class="enroll-step">
        <div class="step-number">2</div>
        <h4>Pay Registration Fee</h4>
        <p>Submit the one-time registration fee of $125 ($75 registration + $50 art fee) to secure your child's spot.</p>
      </div>
    </div>
    <div class="col-sm-12 col-md-4">
      <div class="enroll-step">
        <div class="step-number">3</div>
        <h4>Welcome to CGCA!</h4>
        <p>You'll receive enrollment confirmation and all the information you need to prepare for the first day of school.</p>
      </div>
    </div>
  </div>
  <div class="row"><div class="col-12">&nbsp;</div></div>
  <div class="row">
    <div class="col-12 text-center">
      <Button Type="ButtonType.Link" Color="ButtonColor.Success" Target="Target.Blank" Size="ButtonSize.ExtraLarge"
        Class="btn-rounded" To="https://app.praxischool.com/site_login.php?s=4101">
        <Icon Name="IconName.Alarm" />
        &nbsp;&nbsp;Register Now&nbsp;&nbsp;
        <Icon Name="IconName.Alarm" />
      </Button>
    </div>
  </div>
</section>

<div class="row"><div class="col-12">&nbsp;</div></div>

<!-- Tuition Details -->
<section aria-label="Tuition details">
  <div class="row">
    <div class="col-12">
      <div class="section-header">
        <p class="section-header-title">Tuition &amp; Fees</p>
        <p class="section-header-subtitle">Affordable Christ-centered education</p>
      </div>
    </div>
  </div>
  <div class="row"><div class="col-12">&nbsp;</div></div>
  <div class="row g-4">
    <div class="col-sm-12 col-md-6">
      <Card Style="border-radius: 25px;">
        <CardBody>
          <CardTitle Style="font-size: 1.5em;">Registration</CardTitle>
          <CardText>
            <table class="table table-borderless" style="font-size: 1.1em;">
              <tbody>
                <tr>
                  <td>Registration Fee</td>
                  <td class="text-end"><strong>$75</strong></td>
                </tr>
                <tr>
                  <td>Art &amp; Supplies Fee</td>
                  <td class="text-end"><strong>$50</strong></td>
                </tr>
                <tr class="border-top">
                  <td><strong>Total Registration</strong></td>
                  <td class="text-end"><strong>$125</strong></td>
                </tr>
              </tbody>
            </table>
            <p><small>One-time fee due at enrollment. Non-refundable.</small></p>
          </CardText>
        </CardBody>
      </Card>
    </div>
    <div class="col-sm-12 col-md-6">
      <Card Style="border-radius: 25px;">
        <CardBody>
          <CardTitle Style="font-size: 1.5em;">Monthly Tuition</CardTitle>
          <CardText>
            <table class="table table-borderless" style="font-size: 1.1em;">
              <tbody>
                <tr>
                  <td>Monthly Tuition (all programs)</td>
                  <td class="text-end"><strong>$175 / month</strong></td>
                </tr>
                <tr>
                  <td>Sibling Discount</td>
                  <td class="text-end"><strong>$10 off / sibling</strong></td>
                </tr>
                <tr>
                  <td>Pay-in-Full Discount</td>
                  <td class="text-end"><strong>10% off total</strong></td>
                </tr>
              </tbody>
            </table>
            <p><small>Pay the full year's tuition in advance and save 10%!</small></p>
          </CardText>
        </CardBody>
      </Card>
    </div>
  </div>
</section>

<div class="row"><div class="col-12">&nbsp;</div></div>

<!-- Programs Available -->
<section aria-label="Available programs">
  <div class="row">
    <div class="col-12">
      <div class="section-header">
        <p class="section-header-title">Available Programs</p>
      </div>
    </div>
  </div>
  <div class="row"><div class="col-12">&nbsp;</div></div>
  <div class="row g-4">
    <div class="col-sm-12 col-md-6">
      <Card TextAlignment="Alignment.Center" Style="border-radius: 25px;">
        <CardBody>
          <CardTitle>Pre-School K3</CardTitle>
          <CardText>
            <p>For children age 3</p>
            <p>Tuesday - Thursday<br />9:30 AM - 12:30 PM</p>
            <a href="/programs" class="text-decoration-none">Learn more about K3 &rarr;</a>
          </CardText>
        </CardBody>
      </Card>
    </div>
    <div class="col-sm-12 col-md-6">
      <Card TextAlignment="Alignment.Center" Style="border-radius: 25px;">
        <CardBody>
          <CardTitle>Pre-School K4 / K5</CardTitle>
          <CardText>
            <p>For children ages 4 and 5</p>
            <p>Tuesday - Thursday<br />9:30 AM - 12:30 PM</p>
            <a href="/programs" class="text-decoration-none">Learn more about K4/K5 &rarr;</a>
          </CardText>
        </CardBody>
      </Card>
    </div>
  </div>
</section>

<div class="row"><div class="col-12">&nbsp;</div></div>

<!-- Additional Info -->
<section aria-label="Additional information">
  <div class="row">
    <div class="col-sm-12 col-md-6">
      <Card TextAlignment="Alignment.Start" Style="border: 0px;">
        <CardBody>
          <CardTitle Style="font-size: 1.5em;">Schedule Details</CardTitle>
          <CardText>
            <ul style="line-height: 2em; font-size: 1.05em;">
              <li>Classes: Tuesday, Wednesday, Thursday</li>
              <li>Hours: 9:30 AM - 12:30 PM</li>
              <li>Doors open at 9:15 AM</li>
              <li>Follows BCPS calendar for breaks and holidays</li>
              <li>Before/after care not currently available</li>
            </ul>
          </CardText>
        </CardBody>
      </Card>
    </div>
    <div class="col-sm-12 col-md-6">
      <Card TextAlignment="Alignment.Start" Style="border: 0px;">
        <CardBody>
          <CardTitle Style="font-size: 1.5em;">Questions?</CardTitle>
          <CardText>
            <p style="font-size: 1.05em;">We'd love to hear from you! Our admissions team is happy to answer
              any questions about enrollment, programs, or tuition.</p>
            <p style="font-size: 1.05em;">
              <Icon Name="IconName.Telephone" />&nbsp;&nbsp;<a href="tel:+15025434101">(502) 543-4101</a><br />
              <Icon Name="IconName.Envelope" />&nbsp;&nbsp;<a href="mailto:contactus@cedargrovechristianacademy.org">contactus@cedargrovechristianacademy.org</a>
            </p>
            <a href="/contact" class="btn btn-outline-primary btn-rounded mt-2">Contact Us</a>
          </CardText>
        </CardBody>
      </Card>
    </div>
  </div>
</section>

<!-- Bottom CTA -->
<section aria-label="Register call to action">
  <div class="row">
    <div class="col-12 text-center">
      <div class="section-header" style="padding: 40px 25px;">
        <p class="section-header-title">Don't Wait — Spaces Fill Up Fast!</p>
        <p class="section-header-subtitle" style="margin-bottom: 1rem;">Secure your child's spot for the 2026/27 school year.</p>
        <Button Type="ButtonType.Link" Color="ButtonColor.Light" Target="Target.Blank" Size="ButtonSize.ExtraLarge"
          Class="btn-rounded" To="https://app.praxischool.com/site_login.php?s=4101">
          &nbsp;&nbsp;Register Now&nbsp;&nbsp;
        </Button>
      </div>
    </div>
  </div>
</section>
