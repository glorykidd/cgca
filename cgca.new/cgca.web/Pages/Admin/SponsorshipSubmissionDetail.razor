@page "/admin/sponsorships/{Id:int}"
@attribute [Authorize]
@layout AdminLayout
@rendermode InteractiveServer
@using cgca.web.Services
@using cgca.web.Models
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Sponsorship Inquiry - CGCA Admin</PageTitle>

@if (item == null)
{
    <p>Loading...</p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Inquiry from @item.BusinessName</h2>
        <a href="/admin/sponsorships" class="btn btn-outline-secondary btn-sm">Back to List</a>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <strong>Contact Name:</strong>
                    <p>@item.ContactName</p>
                </div>
                <div class="col-md-6">
                    <strong>Business Name:</strong>
                    <p>@item.BusinessName</p>
                </div>
                <div class="col-md-6">
                    <strong>Email:</strong>
                    <p><a href="mailto:@item.Email">@item.Email</a></p>
                </div>
                <div class="col-md-6">
                    <strong>Phone:</strong>
                    <p>@(item.Phone ?? "N/A")</p>
                </div>
                <div class="col-md-6">
                    <strong>Sponsorship Tier:</strong>
                    <p>@item.SponsorshipTier</p>
                </div>
                <div class="col-md-6">
                    <strong>Status:</strong>
                    <p>
                        <span class="badge @(item.IsRead ? "bg-secondary" : "bg-primary")">
                            @(item.IsRead ? "Read" : "Unread")
                        </span>
                    </p>
                </div>
                <div class="col-md-6">
                    <strong>Acknowledged:</strong>
                    <div class="form-check mt-1">
                        <input class="form-check-input" type="checkbox" id="acknowledgedCheck"
                               checked="@item.IsAcknowledged"
                               @onchange="ToggleAcknowledged" />
                        <label class="form-check-label" for="acknowledgedCheck">
                            @(item.IsAcknowledged ? "Inquiry has been reviewed" : "Mark as reviewed")
                        </label>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(item.Message))
                {
                    <div class="col-12">
                        <strong>Message:</strong>
                        <p style="white-space: pre-wrap;">@item.Message</p>
                    </div>
                }
                <div class="col-md-6">
                    <strong>Submitted:</strong>
                    <p>@item.SubmittedAt.ToLocalTime().ToString("MMMM dd, yyyy 'at' h:mm tt")</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header fw-semibold">Contact Tracking</div>
        <div class="card-body">
            <div class="row g-2">
                <div class="col-md-3 col-6">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="contactedCheck"
                               checked="@item.IsContacted"
                               @onchange='e => SetStatus("IsContacted", e)' />
                        <label class="form-check-label" for="contactedCheck">Contacted</label>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="confirmedCheck"
                               checked="@item.IsConfirmed"
                               @onchange='e => SetStatus("IsConfirmed", e)' />
                        <label class="form-check-label" for="confirmedCheck">Confirmed</label>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="declinedCheck"
                               checked="@item.IsDeclined"
                               @onchange='e => SetStatus("IsDeclined", e)' />
                        <label class="form-check-label" for="declinedCheck">Declined</label>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="addedCheck"
                               checked="@item.IsAddedToSystem"
                               @onchange='e => SetStatus("IsAddedToSystem", e)' />
                        <label class="form-check-label" for="addedCheck">Added to System</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 mb-4">
        <button class="btn btn-outline-primary" @onclick="ToggleRead">
            @(item.IsRead ? "Mark as Unread" : "Mark as Read")
        </button>
        <button class="btn btn-outline-secondary" @onclick="() => showForward = true">Forward</button>
        <button class="btn btn-outline-danger" @onclick="() => showDeleteConfirm = true">Delete</button>
    </div>

    <h5 class="mb-3">Notes</h5>

    @if (item.Notes.Count == 0)
    {
        <p class="text-muted small mb-3">No notes yet.</p>
    }
    else
    {
        <div class="d-flex flex-column gap-2 mb-3">
            @foreach (var note in item.Notes)
            {
                <div class="card border-start border-3 border-info">
                    <div class="card-body py-2 px-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-semibold small">@note.CreatedBy</span>
                            <span class="text-muted small">@note.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy 'at' h:mm tt")</span>
                        </div>
                        <p class="mb-0 small" style="white-space: pre-wrap;">@note.Message</p>
                    </div>
                </div>
            }
        </div>
    }

    <div class="card">
        <div class="card-body">
            <label class="form-label fw-semibold" for="noteText">Add a Note</label>
            <textarea id="noteText" class="form-control mb-2" rows="4"
                      @bind="noteText" placeholder="Enter notes about contact with this sponsor..."></textarea>
            @if (noteError != null)
            {
                <div class="text-danger small mb-2">@noteError</div>
            }
            <button class="btn btn-primary" @onclick="SaveNote" disabled="@noteSaving">
                @(noteSaving ? "Saving…" : "Save Note")
            </button>
        </div>
    </div>
}

@if (showForward)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Forward Inquiry</h5>
                </div>
                <div class="modal-body">
                    <label class="form-label" for="forwardTo">Forward to email address</label>
                    <input id="forwardTo" type="email" class="form-control" @bind="forwardAddress" placeholder="recipient@example.com" />
                    @if (forwardError != null)
                    {
                        <div class="text-danger small mt-1">@forwardError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseForward">Cancel</button>
                    <button class="btn btn-primary" @onclick="ExecuteForward" disabled="@forwardSending">
                        @(forwardSending ? "Sending…" : "Send")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showDeleteConfirm)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Delete</h5>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete this inquiry? This cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showDeleteConfirm = false">Cancel</button>
                    <button class="btn btn-danger" @onclick="ExecuteDelete">Delete</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    [Inject] private SponsorshipSubmissionService SubmissionService { get; set; } = default!;
    [Inject] private EmailService EmailService { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [CascadingParameter] private AuthenticationState AuthState { get; set; } = default!;

    private SponsorshipSubmission? item;
    private string currentUserName = "Admin";
    private bool showDeleteConfirm;

    private bool showForward;
    private string forwardAddress = "";
    private string? forwardError;
    private bool forwardSending;

    private string noteText = "";
    private string? noteError;
    private bool noteSaving;

    protected override async Task OnInitializedAsync()
    {
        currentUserName = AuthState?.User.FindFirst("display_name")?.Value
            ?? AuthState?.User.Identity?.Name
            ?? "Admin";

        item = await SubmissionService.GetByIdWithNotesAsync(Id);
        if (item != null && !item.IsRead)
        {
            await SubmissionService.MarkAsReadAsync(Id);
            item.IsRead = true;
        }
    }

    private async Task ToggleRead()
    {
        if (item == null) return;
        await SubmissionService.ToggleReadAsync(Id);
        item.IsRead = !item.IsRead;
    }

    private async Task ToggleAcknowledged(ChangeEventArgs e)
    {
        if (item == null) return;
        var acknowledged = (bool)(e.Value ?? false);
        await SubmissionService.SetAcknowledgedAsync(Id, acknowledged);
        item.IsAcknowledged = acknowledged;
    }

    private async Task SetStatus(string field, ChangeEventArgs e)
    {
        if (item == null) return;
        var value = (bool)(e.Value ?? false);
        await SubmissionService.SetStatusAsync(Id, field, value);
        switch (field)
        {
            case nameof(SponsorshipSubmission.IsContacted):     item.IsContacted     = value; break;
            case nameof(SponsorshipSubmission.IsConfirmed):     item.IsConfirmed     = value; break;
            case nameof(SponsorshipSubmission.IsAddedToSystem): item.IsAddedToSystem = value; break;
            case nameof(SponsorshipSubmission.IsDeclined):      item.IsDeclined      = value; break;
        }
    }

    private async Task SaveNote()
    {
        noteError = null;

        if (string.IsNullOrWhiteSpace(noteText))
        {
            noteError = "Please enter a note before saving.";
            return;
        }

        noteSaving = true;
        StateHasChanged();
        try
        {
            var note = await SubmissionService.AddNoteAsync(Id, noteText.Trim(), currentUserName);
            item!.Notes.Add(note);
            noteText = "";
        }
        finally
        {
            noteSaving = false;
        }
    }

    private async Task ExecuteForward()
    {
        forwardError = null;

        if (string.IsNullOrWhiteSpace(forwardAddress) || !forwardAddress.Contains('@'))
        {
            forwardError = "Please enter a valid email address.";
            return;
        }

        forwardSending = true;
        StateHasChanged();
        try
        {
            var trimmed = forwardAddress.Trim();
            await EmailService.ForwardSponsorshipSubmissionAsync(item!, trimmed);
            var note = await SubmissionService.AddNoteAsync(Id, $"Inquiry forwarded to {trimmed}.", currentUserName);
            item!.Notes.Add(note);
            forwardAddress = "";
            forwardError = null;
            showForward = false;
        }
        finally
        {
            forwardSending = false;
        }
    }

    private void CloseForward()
    {
        showForward = false;
        forwardAddress = "";
        forwardError = null;
    }

    private async Task ExecuteDelete()
    {
        await SubmissionService.DeleteAsync(Id);
        Nav.NavigateTo("/admin/sponsorships");
    }
}
