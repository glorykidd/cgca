        crossorigin="anonymous"></script>
    <script src="_content/Blazor.Bootstrap/blazor.bootstrap.js"></script>

    <!-- GA4 conversion tracking for CTA clicks -->
    <script>
        document.addEventListener('click', function(e) {
            var link = e.target.closest('a[href], button');
            if (!link) return;
            var href = link.getAttribute('href') || '';
            var text = (link.textContent || '').trim().toLowerCase();

            // Track enrollment/register clicks
            if (href.includes('praxischool.com/site_login')) {
                cgcaTrack('enroll_click', { link_text: text, link_url: href });
            }
            // Track donation clicks
            else if (href.includes('remoteDonationPage')) {
                cgcaTrack('donate_click', { link_text: text, link_url: href });
            }
            // Track newsletter signup clicks
            else if (href.includes('forms.gle/85pj7RGUHaMUNiQy6')) {
                cgcaTrack('newsletter_signup_click', { link_text: text });
            }
            // Track contact form views
            else if (href === '/contact') {
                cgcaTrack('contact_page_click', { link_text: text });
            }
            // Track admissions page views
            else if (href === '/admissions') {
                cgcaTrack('admissions_click', { link_text: text });
            }
        });
    </script>
</body>

